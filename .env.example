# =============================================================================
# OpenFlowKit — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the keys you need.
# All AI keys are OPTIONAL — users can also paste keys directly in
# Settings → AI.
# Never commit your real .env.local file to git!
# Flowpilot defaults to the GitHub Copilot SDK; no API key is required.
# Run `gh copilot login`, then `npm run dev` and open http://127.0.0.1:3000.
# Static hosting cannot run the SDK. A separate authenticated hosted server is
# available; see docs/hosted-copilot.md for production setup and approval gates.
# Copilot credentials stay in the CLI; never put them in a VITE_* variable.
# To override the bundled CLI, export COPILOT_CLI_PATH in your shell.
# =============================================================================


# -----------------------------------------------------------------------------
# 🤖 AI PROVIDERS
# Get your key from the provider's console and paste it here OR in the UI.
# Leave empty to disable that provider as a default.
# -----------------------------------------------------------------------------

# Google Gemini — https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
VITE_CLAUDE_API_KEY=

# Groq (Llama, Mistral, Qwen on ultra-fast inference) — https://console.groq.com/keys
VITE_GROQ_API_KEY=

# NVIDIA NIM (Llama, Nemotron, Kimi, DeepSeek etc.) — https://build.nvidia.com/
VITE_NVIDIA_API_KEY=

# Cerebras (fastest inference on WSE-3) — https://cloud.cerebras.ai/
VITE_CEREBRAS_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys/
VITE_MISTRAL_API_KEY=

# Custom / Self-hosted OpenAI-compatible endpoint
# e.g. Ollama running locally: http://localhost:11434/v1
VITE_CUSTOM_AI_BASE_URL=
VITE_CUSTOM_AI_API_KEY=
VITE_CUSTOM_AI_MODEL=

# -----------------------------------------------------------------------------
# 🚀 DEPLOYMENT
# -----------------------------------------------------------------------------

# Optional public base URL for share links and generated MCP configuration.
# Leave empty to automatically use the browser's hosting origin.
# Set at build time to override it, e.g. https://diagrams.example.com
# The MCP page copies this value into the server's OPENFLOWKIT_APP_URL.
VITE_APP_URL=

# Hosted Node server only. Keep these out of VITE_* variables and browser builds.
# Use Azure Key Vault references in production. For loopback-only development,
# use a gitignored .env.hosted.local and node --env-file=.env.hosted.local.
PUBLIC_ORIGIN=
HOSTED_GITHUB_CLIENT_ID=
HOSTED_GITHUB_CLIENT_SECRET=
# A random 32-byte key encoded as base64; keep stable across deployments.
HOSTED_SESSION_KEY=
HOSTED_STORAGE_ACCOUNT=
# Client ID of the Azure runtime managed identity (not the GitHub App client ID).
AZURE_CLIENT_ID=
# Explicit local proof mode: HTTP loopback only, in-memory auth, never production.
HOSTED_DEVELOPMENT=false
