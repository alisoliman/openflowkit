# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
ENV CI=1 HUSKY=0
ARG NPM_REGISTRY=https://registry.npmjs.org/
COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
COPY docs-site/package.json ./docs-site/package.json
COPY mcp-server/package.json ./mcp-server/package.json
RUN --mount=type=cache,id=openflowkit-hosted-npm,target=/root/.npm,sharing=locked \
    npm ci --registry="$NPM_REGISTRY" --no-audit --no-fund

FROM dependencies AS build
COPY . .
RUN npm run build:hosted

FROM node:22-bookworm-slim AS production-dependencies
WORKDIR /app
ENV CI=1 HUSKY=0
ARG NPM_REGISTRY=https://registry.npmjs.org/
COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
COPY docs-site/package.json ./docs-site/package.json
COPY mcp-server/package.json ./mcp-server/package.json
RUN --mount=type=cache,id=openflowkit-hosted-npm,target=/root/.npm,sharing=locked \
    npm ci --registry="$NPM_REGISTRY" --omit=dev --workspaces=false --no-audit --no-fund

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && apt-get clean
ENV NODE_ENV=production PORT=3045
ARG APP_REVISION=development
ENV APP_REVISION=${APP_REVISION}
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-server ./dist-server
USER node
EXPOSE 3045
HEALTHCHECK --interval=30s --timeout=20s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3045/healthz',{signal:AbortSignal.timeout(15000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist-server/entry.js"]
